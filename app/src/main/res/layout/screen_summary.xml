<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" tools:visibility="visible" android:paddingHorizontal="20dp" android:paddingBottom="24dp" android:id="@+id/pageSummary">
    <Button style="@style/Secondary" android:id="@+id/btnSummaryBack" android:text="@string/btnSummaryBack" android:layout_width="wrap_content" android:layout_height="48dp" android:background="@android:color/transparent" android:textColor="@color/lime" android:textSize="12sp" android:paddingHorizontal="0dp" />
    <ImageView android:src="@drawable/ic_check" android:layout_width="38dp" android:layout_height="38dp" android:importantForAccessibility="no" android:layout_gravity="center" android:background="@drawable/icon_bg" android:padding="8dp" />
    <TextView style="@style/Text" android:id="@+id/tvSummaryEyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tvSummaryEyebrow" android:textSize="10sp" android:textColor="@color/muted" android:layout_gravity="center" android:letterSpacing="0.14" android:layout_marginTop="12dp" />
    <TextView style="@style/Title" android:id="@+id/tvSummaryTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tvSummaryTitle" android:textSize="23sp" android:textColor="@color/text" android:layout_gravity="center" android:gravity="center" android:lineSpacingExtra="3dp" android:layout_marginTop="9dp" />
    <TextView style="@style/Text" android:id="@+id/tvSummarySubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tvSummarySubtitle" android:textSize="12sp" android:textColor="@color/muted" android:layout_gravity="center" android:layout_marginTop="10dp" android:layout_marginBottom="20dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/lime" android:padding="20dp">
        <TextView style="@style/Text" android:id="@+id/summaryStepLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/summaryStepLabel" android:textSize="13sp" android:textColor="@color/lime_ink" android:layout_gravity="center" />
        <TextView style="@style/Text" android:id="@+id/tvSummarySteps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tvSummarySteps" android:textSize="65sp" android:textColor="@color/lime_ink" android:fontFamily="sans-serif-medium" android:layout_gravity="center" android:layout_marginTop="7dp" android:letterSpacing="-0.05" />
        <TextView style="@style/Text" android:id="@+id/summaryCaption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/summaryCaption" android:textSize="12sp" android:textColor="#536F3B" android:layout_gravity="center" />
        <TextView style="@style/Text" android:id="@+id/tvSummaryGoal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tvSummaryGoal" android:textSize="11sp" android:textColor="#4C6833" android:layout_gravity="center" android:layout_marginTop="15dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false" android:layout_marginTop="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card" android:padding="17dp" android:layout_weight="1">
            <ImageView android:src="@drawable/ic_history" android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" />
            <TextView style="@style/Text" android:id="@+id/summaryDurationLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/summaryDurationLabel" android:textSize="12sp" android:textColor="@color/muted" android:layout_marginTop="9dp" />
            <TextView style="@style/Title" android:id="@+id/tvSummaryDuration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tvSummaryDuration" android:textSize="25sp" android:textColor="@color/text" android:layout_marginTop="8dp" />
        </LinearLayout>
        <Space android:layout_width="10dp" android:layout_height="1dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card" android:padding="17dp" android:layout_weight="1">
            <ImageView android:src="@drawable/ic_shake" android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" android:tint="@color/lilac" />
            <TextView style="@style/Text" android:id="@+id/summaryShakeLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/summaryShakeLabel" android:textSize="12sp" android:textColor="@color/muted" android:layout_marginTop="9dp" />
            <TextView style="@style/Title" android:id="@+id/tvSummaryShakes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tvSummaryShakes" android:textSize="25sp" android:textColor="@color/text" android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_gravity="center" android:layout_marginTop="12dp" android:id="@+id/summaryBadges">
        <TextView style="@style/Badge" android:id="@+id/summaryStepBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/summaryStepBadge" android:textSize="14sp" android:textColor="@color/text" />
        <TextView style="@style/Badge" android:id="@+id/summaryShakeBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/summaryShakeBadge" android:textSize="14sp" android:textColor="@color/lilac" android:background="@drawable/badge_shake" android:layout_marginTop="6dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false" android:paddingVertical="15dp">
        <TextView style="@style/Text" android:id="@+id/summaryRateLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/summaryRateLabel" android:textSize="12sp" android:textColor="@color/muted" android:layout_weight="1" />
        <TextView style="@style/Text" android:id="@+id/tvSummaryRate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tvSummaryRate" android:textSize="13sp" android:textColor="@color/text" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false" android:paddingBottom="15dp">
        <TextView style="@style/Text" android:id="@+id/summaryShakeRateLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/summaryShakeRateLabel" android:textSize="12sp" android:textColor="@color/muted" android:layout_weight="1" />
        <TextView style="@style/Text" android:id="@+id/tvSummaryShakeRate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tvSummaryShakeRate" android:textSize="13sp" android:textColor="@color/text" />
    </LinearLayout>
    <TextView style="@style/Text" android:id="@+id/summaryThanks" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/summaryThanks" android:textSize="13sp" android:textColor="#B8CDA7" android:layout_gravity="center" android:gravity="center" android:lineSpacingExtra="4dp" android:layout_marginTop="12dp" />
    <Button style="@style/Secondary" android:id="@+id/btnDiscard" android:text="@string/btnDiscard" android:textSize="12sp" android:textColor="@color/muted" android:background="@android:color/transparent" android:layout_marginTop="6dp" />
</LinearLayout>
