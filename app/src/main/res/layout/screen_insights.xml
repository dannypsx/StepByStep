<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" tools:visibility="visible" android:paddingHorizontal="20dp" android:paddingBottom="24dp" android:id="@+id/pageInsights">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="11dp" android:layout_marginBottom="22dp">
        <TextView style="@style/Text" android:id="@+id/insightKicker" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/insightKicker" android:textSize="10sp" android:textColor="#A6BB92" android:letterSpacing="0.12" />
        <TextView style="@style/Title" android:id="@+id/insightTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/insightTitle" android:textSize="25sp" android:textColor="@color/text" android:layout_marginTop="8dp" />
        <TextView style="@style/Text" android:id="@+id/insightSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/insightSub" android:textSize="12sp" android:textColor="@color/muted" android:layout_marginTop="7dp" android:lineSpacingExtra="3dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card" android:padding="17dp">
        <TextView style="@style/Text" android:id="@+id/insightTotalLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/insightTotalLabel" android:textSize="13sp" android:textColor="@color/muted" />
        <TextView style="@style/Text" android:id="@+id/tvInsightSteps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tvInsightSteps" android:textSize="53sp" android:textColor="@color/lime" android:fontFamily="sans-serif-medium" android:layout_marginTop="10dp" />
        <TextView style="@style/Text" android:id="@+id/tvInsightMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tvInsightMeta" android:textSize="12sp" android:textColor="@color/muted" android:layout_marginTop="8dp" />
    </LinearLayout>
    <TextView style="@style/Title" android:id="@+id/chartHeading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/chartHeading" android:textSize="15sp" android:textColor="@color/text" android:layout_marginTop="25dp" android:layout_marginBottom="14dp" />
    <com.stepbystep.ui.views.ActivityChartView android:id="@+id/activityChart" android:layout_width="match_parent" android:layout_height="180dp" android:contentDescription="@string/chart_description" />
    <TextView style="@style/Text" android:id="@+id/tvBestRecords" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tvBestRecords" android:textSize="13sp" android:textColor="#C5D9B2" android:background="@drawable/cumulative" android:padding="17dp" android:layout_marginTop="20dp" android:lineSpacingExtra="4dp" />
</LinearLayout>
