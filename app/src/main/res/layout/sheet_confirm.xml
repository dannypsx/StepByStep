<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/sheet" android:padding="23dp">
    <View android:layout_width="34dp" android:layout_height="4dp" android:layout_gravity="center" android:background="#5D7050" android:layout_marginBottom="22dp" />
    <TextView style="@style/Title" android:id="@+id/tvConfirmTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tvConfirmTitle" android:textSize="21sp" android:textColor="@color/text" />
    <TextView style="@style/Text" android:id="@+id/tvConfirmMessage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tvConfirmMessage" android:textSize="13sp" android:textColor="@color/muted" android:layout_marginTop="12dp" android:lineSpacingExtra="5dp" />
    <TextView style="@style/Text" android:id="@+id/tvConfirmPreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tvConfirmPreview" android:textSize="13sp" android:textColor="@color/text" android:background="@drawable/card" android:padding="15dp" android:layout_marginTop="17dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false" android:layout_marginTop="20dp">
        <Button style="@style/Secondary" android:id="@+id/btnCancel" android:text="@string/btnCancel" android:layout_width="0dp" android:layout_weight="1" />
        <Button style="@style/Secondary" android:id="@+id/btnConfirm" android:text="@string/btnConfirm" android:background="@drawable/button_danger" android:textColor="#EFBDA2" android:layout_marginStart="10dp" android:layout_width="0dp" android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
