<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Label" parent="Text">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Title" parent="Text">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Action">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/lime_ink</item>
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Secondary" parent="Action">
        <item name="android:textColor">@color/text</item>
        <item name="android:background">@drawable/button_secondary</item>
    </style>
    <style name="Nav" parent="Action">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:padding">6dp</item>
        <item name="android:background">@drawable/nav_background</item>
        <item name="android:textColor">@color/nav_tint</item>
        <item name="android:drawableTint">@color/nav_tint</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:layout_marginHorizontal">3dp</item>
    </style>
    <style name="Badge" parent="Label">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:background">@drawable/badge_step</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">5dp</item>
    </style>
</resources>
